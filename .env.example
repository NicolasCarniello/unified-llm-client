# Copiá este archivo como .env y completá tus valores:  cp .env.example .env
# El .env está en .gitignore: NUNCA lo subas al repositorio.

# ── Proveedor activo ─────────────────────────────────────────
# Opciones: openai | anthropic
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────
# Obtené tu key en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ────────────────────────────────────────────────
# Obtené tu key en https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Alternativa más económica para pruebas: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# ── Opcionales (si no se definen se usan los valores por defecto) ──
# LLM_TEMPERATURE=0.7      # 0 a 2. Solo OpenAI (Claude no lo soporta y lo ignora)
# LLM_MAX_TOKENS=2048      # 1 a 16384
# LLM_MAX_RETRIES=3        # reintentos ante errores transitorios (0 a 10)
